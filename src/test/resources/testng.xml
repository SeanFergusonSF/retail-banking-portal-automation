<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Bank Portal Automation Suite" verbose="1" parallel="tests" thread-count="3">

    <listeners>
        <listener class-name="com.bankportal.utils.TestListener"/>
        <listener class-name="com.bankportal.utils.RetryListener"/>
    </listeners>

    <test name="API Tests">
        <classes>
            <class name="com.bankportal.api.runners.ApiTestRunner"/>
        </classes>
    </test>

    <test name="UI Tests">
        <classes>
            <class name="com.bankportal.ui.runners.UiTestRunner"/>
        </classes>
    </test>

    <test name="Accessibility Tests">
        <classes>
            <class name="com.bankportal.ui.runners.AccessibilityTestRunner"/>
        </classes>
    </test>

</suite>